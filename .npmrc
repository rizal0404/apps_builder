auto-install-peers=true
strict-peer-dependencies=false

# Windows-friendly install mode.
#
# pnpm's default uses hardlinks + atomic renames inside `node_modules/.pnpm/`,
# which on Windows can race with Defender / antivirus / file indexers and crash
# the install with errors like:
#   ENOENT: no such file or directory, rename '.../foo' -> '.../.ignored_foo'
#
# `package-import-method=copy` swaps hardlinks for plain copies, and
# `node-linker=hoisted` flattens `node_modules` to an npm-style layout. Both are
# slower / use more disk than the default, but are robust on Windows and have
# no impact on Linux / macOS / CI behaviour beyond a slightly larger
# `node_modules` directory.
package-import-method=copy
node-linker=hoisted
